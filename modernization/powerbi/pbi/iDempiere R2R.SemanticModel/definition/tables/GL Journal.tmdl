	partition 'GL Journal' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "\fact_acct.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {{"fact_acct_id", Int64.Type}, {"ad_client_id", Int64.Type}, {"ad_org_id", Int64.Type}, {"c_acctschema_id", Int64.Type}, {"account_id", Int64.Type}, {"datetrx", type date}, {"dateacct", type date}, {"c_period_id", Int64.Type}, {"ad_table_id", Int64.Type}, {"record_id", Int64.Type}, {"postingtype", type text}, {"c_currency_id", Int64.Type}, {"amtsourcedr", Currency.Type}, {"amtsourcecr", Currency.Type}, {"amtacctdr", Currency.Type}, {"amtacctcr", Currency.Type}, {"c_bpartner_id", Int64.Type}, {"description", type text}}, "en-US")
			in
			    Typed

	annotation iDempiere_Table = fact_acct

