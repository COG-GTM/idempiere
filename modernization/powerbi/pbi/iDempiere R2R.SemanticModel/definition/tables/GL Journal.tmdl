table 'GL Journal'
	lineageTag: 353dd9cd-474e-546b-997b-0f80a26d9b4a

	/// Actual debits (PostingType A), as in every iDempiere accounting report
	measure Debit = CALCULATE ( SUM ( 'GL Journal'[Amt Acct Dr] ), 'GL Journal'[Posting Type] = "A" )
		formatString: #,0.00
		displayFolder: Ledger
		lineageTag: 2c3a681c-98f0-55fb-9508-e237a28df626

	/// Actual credits (PostingType A)
	measure Credit = CALCULATE ( SUM ( 'GL Journal'[Amt Acct Cr] ), 'GL Journal'[Posting Type] = "A" )
		formatString: #,0.00
		displayFolder: Ledger
		lineageTag: d86cad61-7d61-5c81-8cc2-abf4c39bcbb7

	/// AmtAcctDr - AmtAcctCr (iDempiere AmtAcctBalance)
	measure Balance = [Debit] - [Credit]
		formatString: #,0.00
		displayFolder: Ledger
		lineageTag: 1ba090b4-8511-5cc8-83be-cd7dfb75be59

	/// Should always be 0: every posted document balances
	measure 'Out Of Balance' = ROUND ( [Debit] - [Credit], 2 )
		formatString: #,0.00
		displayFolder: Ledger
		lineageTag: 47532929-91e2-5e34-b169-fa39adf16a66

	/// Budget postings (PostingType B)
	measure 'Budget Balance' = CALCULATE ( SUM ( 'GL Journal'[Amt Acct Dr] ) - SUM ( 'GL Journal'[Amt Acct Cr] ), 'GL Journal'[Posting Type] = "B" )
		formatString: #,0.00
		displayFolder: Ledger
		lineageTag: 873639b5-9af1-50da-9043-e9a27cb0a807

	/// Actual Fact_Acct lines
	measure 'Journal Lines' = CALCULATE ( COUNTROWS ( 'GL Journal' ), 'GL Journal'[Posting Type] = "A" )
		formatString: #,0
		displayFolder: Ledger
		lineageTag: d72cda89-7bb5-5fd7-988c-94549fdc0e3a

